# DeepSeek API
# 申请: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选:覆盖默认 model id。默认 deepseek-chat。
# 若用其它型号(如 deepseek-v4-flash),在 DeepSeek 控制台确认实际 id 后填入
# DEEPSEEK_MODEL=deepseek-v4-flash

# 可选:覆盖默认 endpoint
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions

# 可选:生产域名(影响 OG / sitemap 绝对 URL)。Vercel 部署可不填(自动用 VERCEL_URL)
# NEXT_PUBLIC_SITE_URL=https://shiguang.app

# Upstash Redis (Vercel KV 也用同一组变量名)
# 申请: https://console.upstash.com/  或 Vercel Dashboard → Storage → Marketplace → Upstash
# 本地不配则用文件 fallback,持久化在 .data/recommendations/<id>.json
KV_REST_API_URL=
KV_REST_API_TOKEN=
